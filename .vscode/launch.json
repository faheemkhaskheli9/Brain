{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Brain Lab: play",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/game/play.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Brain Lab: scorecard (eval.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/game/eval.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Brain Lab: test_sim",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/game/test_sim.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Brain Lab: test_levels",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/game/test_levels.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Brain Lab: serve web + world (http://localhost:8000/game/)",
      "type": "debugpy",
      "request": "launch",
      "module": "http.server",
      "args": ["8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "World: test_brain.mjs",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/test_brain.mjs",
      "console": "integratedTerminal"
    },
    {
      "name": "World: perform.mjs (--seed 1)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/perform.mjs",
      "args": ["--seed", "1"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: perform.mjs free play (--seed 1 any)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/perform.mjs",
      "args": ["--seed", "1", "any"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: sweep.mjs (sleep vs rehearsal, seeds 1-10)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/sweep.mjs",
      "args": ["--arms", "rehearse30,rehearse10+sleep,rehearse0+sleep,rehearse10+sleepActor,rehearse0+sleepActor", "--jobs", "4"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: sweep.mjs (k-WTA sparsity, seeds 1-10)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/sweep.mjs",
      "args": ["--arms", "rehearse30,kwta20,kwta35,kwta50", "--jobs", "4"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: sweep.mjs (time-limit bootstrapping, seeds 1-10)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/sweep.mjs",
      "args": ["--arms", "rehearse30,timeoutSense,timeoutBootstrap", "--jobs", "4"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: sweep.mjs (innate prior x learning rule, seeds 1-10)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/sweep.mjs",
      "args": ["--arms", "rehearse30,orient,sleepActor30,orient+sleepActor30", "--jobs", "4"],
      "console": "integratedTerminal"
    },
    {
      "name": "World: sweep.mjs (synaptic intelligence + sixth skill copy, seeds 1-10)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/game/world/sweep.mjs",
      "args": ["--arms", "copy,copy+si,copy15,copy15+si", "--jobs", "4"],
      "console": "integratedTerminal"
    },
    {
      "name": "KB: build_index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_index.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "KB: run_code_blocks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_code_blocks.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: verify_sources (learning-algorithm hypotheses)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/verify_sources.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: replay_selection (replay rule x budget x downscaling, #84)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/replay_selection.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: credit_assignment (PC vs backprop, FA, DFA; H001-H003, #92)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/credit_assignment.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: dendritic_neurons (point vs dendritic at equal params, #85)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/dendritic_neurons.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: spike_timing_areas (timing vs count per visual area, #86)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/spike_timing_areas.py",
      "args": ["--fetch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Research: cotuned_inputs (co-tuned inputs on one branch, MICrONS, #87)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/research/cotuned_inputs.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
